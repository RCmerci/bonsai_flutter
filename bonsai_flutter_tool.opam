opam-version: "2.0"
name: "bonsai_flutter_tool"
version: "0.1.0~dev"
synopsis: "OCaml-first tooling for Bonsai Flutter applications"
description: """
The bonsai-flutter command initializes, validates, builds, and runs external
Bonsai Flutter applications while keeping Flutter and Apple build mechanics
behind an OCaml command-line interface.
"""
maintainer: "bonsai_flutter contributors"
authors: ["bonsai_flutter contributors"]
license: "MIT"
homepage: "https://github.com/rcmerci/bonsai_flutter"
bug-reports: "https://github.com/rcmerci/bonsai_flutter/issues"
dev-repo: "git+https://github.com/rcmerci/bonsai_flutter.git"
depends: [
  "ocaml" {= "5.1.1"}
  "dune" {>= "3.17"}
  "cmdliner" {>= "1.3.0"}
  "digestif" {= "1.3.1"}
  "sexplib" {>= "v0.17" & < "v0.18~"}
  "alcotest" {with-test & = "1.7.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
install: [
  ["mkdir" "-p" "%{share}%/bonsai_flutter_tool/framework/flutter/packages"]
  ["cp" "-R" "flutter/packages/bonsai_flutter" "%{share}%/bonsai_flutter_tool/framework/flutter/packages/"]
  ["cp" "-R" "flutter/packages/bonsai_flutter_native" "%{share}%/bonsai_flutter_tool/framework/flutter/packages/"]
  ["cp" "-R" "ocaml" "%{share}%/bonsai_flutter_tool/framework/"]
  ["cp" "-R" "protocol" "%{share}%/bonsai_flutter_tool/framework/"]
  ["cp" "-R" "tool" "%{share}%/bonsai_flutter_tool/framework/"]
  ["cp" "-R" "vendor" "%{share}%/bonsai_flutter_tool/framework/"]
  ["cp" "dune-project" "%{share}%/bonsai_flutter_tool/framework/dune-project"]
]
available: arch != "x86_32"
