  src: "https://github.com/RCmerci/bonsai_flutter/archive/509fd91297d186ea56f7c4a9025920c395b2907a.tar.gz"
  checksum: ["sha256=3419b9c73be37478a190263f415083b311177dd5afdaa502cc0447b11942c919"]
