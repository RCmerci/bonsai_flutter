opam-version: "2.0"
name: "bonsai_flutter_counter_example"
version: "0.1.0"
synopsis: "Bonsai Flutter counter example"
maintainer: "bonsai_flutter contributors"
authors: ["bonsai_flutter contributors"]
license: "MIT"
depends: [
  "ocaml" {= "5.1.1"}
  "dune" {>= "3.17"}
  "bonsai_flutter" {= "0.1.0~dev"}
  "base" {>= "v0.17" & < "v0.18~"}
  "bonsai" {>= "v0.17" & < "v0.18~"}
  "incr_dom" {>= "v0.17" & < "v0.18~"}
  "virtual_dom" {>= "v0.17" & < "v0.18~"}
]
build: [["dune" "build" "-p" name "-j" jobs]]
